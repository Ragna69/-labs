import pandas as pd
from sklearn.preprocessing import MinMaxScaler

df = pd.read_csv('train.csv')
print("Загружено:", df.shape)
display(df.head())
df.info()


# 3: Показывает пропуски
print("Пропуски до:", df.isnull().sum()[df.isnull().sum() > 0])

# 4: Заполняет и показывает результат
for col in df.columns[df.isnull().any()]: # находит имена всех столбцов с пропусками
    val = df[col].mode()[0] if df[col].dtype == 'object' else df[col].median()
    df[col].fillna(val, inplace=True)

print("Пропуски после:", df.isnull().sum().sum())


# 5: Нормализация числовых признаков
num_cols = ['LotArea', 'GrLivArea', 'TotalBsmtSF', 'GarageCars', 'YearBuilt']
df[num_cols] = MinMaxScaler().fit_transform(df[num_cols])

# 6: One-Hot Encoding с защитой от переобучения
df_final = pd.get_dummies(df, columns=df.select_dtypes(include='object').columns, drop_first=True)
print("Размер итоговой матрицы:", df_final.shape)
display(df_final.head())


df_final.to_csv("processed_house_prices.csv", index=False)
print("Файл сохранен. Готово к загрузке на GitHub.")



